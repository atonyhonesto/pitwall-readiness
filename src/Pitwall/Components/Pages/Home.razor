@page "/"
@rendermode InteractiveServer
@inject ReadinessStore Store
@inject ILogger<Home> Logger
<PageTitle>Pitwall • Session readiness</PageTitle>
<header><a class="brand" href="/">◧ PITWALL <span>READINESS</span></a><span class="badge">DEMO / SYNTHETIC DATA</span></header>
<main>
<div class="eyebrow">RACE OPERATIONS / SESSION 04</div>
<h1>Ready for the green.</h1>
<p class="intro">A shared release gate for the people behind the car.</p>
<section class="event"><div><small>ENDURANCE TEST • ROAD ATLANTA</small><h2>Car 27 <span>/ Prototype</span></h2></div><div><small>SESSION</small><strong>Practice 02</strong></div><div><small>RELEASE GATE</small><strong class="@(ReleasePolicy.CanRelease(items) ? "green" : "amber")">@(ReleasePolicy.CanRelease(items) ? "CLEAR" : "HOLD")</strong></div></section>
@if (loading) { <p role="status">Loading the board…</p> }
@if (message is not null) { <p class="notice" role="status">@message</p> }
<div class="metrics"><article><small>CHECKS COMPLETE</small><strong>@items.Count(x => x.Complete)<em> / @items.Count</em></strong></article><article><small>CRITICAL BLOCKERS</small><strong>@items.Count(x => x.Critical && !x.Complete)</strong></article><article><small>WORKFLOW</small><strong class="metric-text">Review → Verify → Release</strong></article></div>
<div class="columns"><section><div class="section-head"><h2>Session checklist</h2><button disabled="@busy" @onclick="Load">Refresh board</button></div>
<p class="muted">Critical items gate release. Optional tasks remain visible.</p>
@foreach (var item in items)
{
<article class="check" @key="item.Id"><div class="check-icon @(item.Complete ? "done" : "")">@(item.Complete ? "✓" : "○")</div><div class="check-body"><small>@item.Area • @item.Owner</small><h3>@item.Title</h3><span class="@(item.Critical ? "critical" : "muted")">@(item.Critical ? "CRITICAL" : "OPTIONAL")</span></div><button disabled="@busy" aria-label="@(item.Complete ? "Reopen " + item.Title : "Complete " + item.Title)" @onclick="() => Toggle(item)">@(item.Complete ? "Reopen" : "Complete")</button></article>
}
</section><aside><h2>Decision log</h2><p class="muted">Persisted changes • UTC</p>@if (audit.Count == 0) { <p>No changes recorded yet.</p> }@foreach(var entry in audit) { <article class="audit"><small>@entry.ChangedAt.ToString("HH:mm:ss 'UTC'")</small><p>@entry.Title</p><span>@(entry.Complete ? "Verified complete" : "Reopened for review")</span></article> }<div class="note"><small>RELEASE STANDARD</small><p>Resolve every critical blocker before the session. Refresh the board before handover and review any reopened checks.</p></div></aside></div>
<footer>Illustrative team workflow. This demo is not a race safety or compliance system.</footer>
</main>
@code {
    List<CheckItem> items = [];
    List<AuditEntry> audit = [];
    bool loading = true, busy;
    string? message;
    protected override async Task OnInitializedAsync() => await Load();
    async Task Load()
    {
        busy = true;
        try { items = await Store.GetChecksAsync(); audit = await Store.GetAuditAsync(); message = null; }
        catch (Exception ex) { items = []; Logger.LogError(ex, "Board load failed"); message = "Board unavailable. Check database setup and refresh. Release remains on hold."; }
        finally { loading = false; busy = false; }
    }
    async Task Toggle(CheckItem item)
    {
        busy = true;
        try { var saved = await Store.SetCompleteAsync(item.Id, item.Version, !item.Complete); await Load(); if (!saved) message = "Another operator changed this item. Board refreshed; review before trying again."; }
        catch (Exception ex) { Logger.LogError(ex, "Checklist update failed"); message = "Update could not be confirmed. Refresh before retrying."; }
        finally { busy = false; }
    }
}

